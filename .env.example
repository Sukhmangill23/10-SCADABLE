# Options: firecrawl or crawl4ai. Neither adapter performs crawling yet.
CRAWLER_PROVIDER=firecrawl
# Needed only when the Firecrawl adapter is implemented.
FIRECRAWL_API_KEY=
# Needed only when constructing the OpenAI client wrapper.
OPENAI_API_KEY=
# Set a model that supports Responses API structured outputs.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30

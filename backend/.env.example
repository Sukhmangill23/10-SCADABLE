# Copy to backend/.env and fill in. Never commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/live_swot

# LLM analysis (Person 2). On Railway set these as service Variables.
OPENAI_API_KEY=
# Confirm the exact model ID with the team ("Luna" per Oct 17 meeting notes).
OPENAI_MODEL=luna
OPENAI_TIMEOUT_SECONDS=40

# USD per 1M tokens for OPENAI_MODEL. Leave blank to report cost as null.
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=
# Abort a run before calling the API if its estimated cost exceeds this.
LLM_MAX_COST_PER_RUN_USD=0.50

# true: fall back to mock SWOT (loud warning) when the key/model is missing.
# Set to false on Railway so a misconfigured deploy fails instead of showing mock data.
LLM_ALLOW_MOCK=true

LLM_MAX_CHARS_PER_PAGE=6000
LLM_MAX_TOTAL_CHARS=40000

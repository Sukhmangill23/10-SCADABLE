# Copy to backend/.env and fill in. Never commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/live_swot

# LLM analysis (Person 2). On Railway set these as service Variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=40

# Model prices live in app/llm/pricing.py (PRICE_TABLE).
# Abort a run when its estimated cost would pass this (typical run ~ $0.01).
MAX_RUN_COST_USD=0.25
# Total LLM budget for the project; warnings at 50% and 80%.
PROJECT_BUDGET_USD=100

# true: fall back to mock SWOT (loud warning) when the key/model is missing.
# Set to false on Railway so a misconfigured deploy fails instead of showing mock data.
LLM_ALLOW_MOCK=true

LLM_MAX_CHARS_PER_PAGE=6000
LLM_MAX_TOTAL_CHARS=40000

# API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Use mock fixtures instead of the live FastAPI backend.
# Set to "false" when the backend is ready.
NEXT_PUBLIC_USE_MOCKS=true

# Clerk (required for real sign-in — do not commit .env.local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: allow “Go to dashboard” bypass outside next dev (never in real prod)
# ALLOW_DEV_DASHBOARD_BYPASS=true
